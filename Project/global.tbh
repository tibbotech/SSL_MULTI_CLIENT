'DEFINES-------------------------------------------------------------

'--- Network (static IP) ---
const DEVICE_IP   = "192.168.1.218"
const DEVICE_MASK = "255.255.255.0"
const DEVICE_GW   = "192.168.1.1"

'--- TLS Client ---
'Number of simultaneous outbound TLS connections.
'The SSL pool supports up to ~7 concurrent sessions; keep this value at 6 or below.
'Sockets 0 to NUM_TLS_SOCKS-1 are used directly (no socket allocation library needed).
const NUM_TLS_SOCKS = 6

'Remote server all sockets connect to.
const SERVER_IP   = "192.168.1.70"
const SERVER_PORT = 8444

'Connections are opened one at a time from on_sys_timer to avoid overloading the server.
'on_sys_timer fires every 0.5 s by default, so 1 tick = 500 ms between connections.
const CONNECT_INTERVAL_TICKS = 1

'Socket buffer sizes in pages (1 page = 256 bytes).
'6 pages (1536 bytes) is sufficient for ECDSA P-256 certificates.
'Increase to 8 pages (2048 bytes) if using RSA 2048 certificates.
#define TLS_RX_BUFF 6
#define TLS_TX_BUFF 6

'ROM file name: server certificate DER (no private key — client only needs the cert).
'See the article "Outbound TLS: Setting Up a TLS Client" for generation steps.
#define CA_CERT "ca_cert.der"

'INCLUDES------------------------------------------------------------

'DECLARATIONS--------------------------------------------------------
declare sub boot()
declare sub tls_client_event(newstate as pl_sock_state, newstatesimple as pl_sock_state_simple)
declare sub tls_client_data()
declare function count_active() as byte
declare sub connect_next()
